"""
servo_keyboard_control.py — Runs on the UNO Q's Linux side (MPU).

Reads raw arrow-key presses from an interactive terminal and forwards them
to the MCU sketch (servo_sketch.ino), which moves two DS3240 servos via
the Servo.h library.

IMPORTANT: capturing raw keypresses needs an attached interactive
terminal. Run this over SSH directly rather than through App Lab's
background/log-only execution mode:

    ssh <user>@<uno-q-ip>
    cd ~/ArduinoApps/<your-app-folder>/python
    python3 servo_keyboard_control.py

Controls:
    Arrow keys  -> pan/tilt the servos
    Space       -> re-center both servos
    q           -> quit
"""

from arduino.app_utils import *
import sys
import tty
import termios
import select


def read_key(timeout=0.05):
    """Non-blocking read of a single keypress. Decodes arrow-key escape
    sequences (ESC [ A/B/C/D) into 'up' / 'down' / 'right' / 'left'."""
    ready, _, _ = select.select([sys.stdin], [], [], timeout)
    if not ready:
        return None
    ch = sys.stdin.read(1)
    if ch == "\x1b":  # start of an escape sequence
        ch2 = sys.stdin.read(1)
        ch3 = sys.stdin.read(1)
        return {"A": "up", "B": "down", "C": "right", "D": "left"}.get(ch3)
    if ch == " ":
        return "center"
    if ch == "q":
        return "quit"
    return None


def loop():
    key = read_key()
    if key == "quit":
        raise KeyboardInterrupt
    if key:
        result = Bridge.call("move_servo", key)
        print(f"[key] {key} -> {result}")


if __name__ == "__main__":
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)  # read keys immediately, no Enter needed
        print("Arrow keys move the servos. Space = center. q = quit.")
        App.run(user_loop=loop)
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)


/*
 * servo_sketch.ino — Runs on the UNO Q's MCU side (STM32U585, via Arduino IDE / App Lab).
 *
 * Drives two DS3240 40KG digital servos with the standard Servo.h library.
 * Movement commands ("up"/"down"/"left"/"right"/"center") arrive from the
 * Python keyboard-reader script (MPU side) over the Bridge.
 *
 * Wiring:
 *   Servo 1 (pan)  signal -> D9
 *   Servo 2 (tilt) signal -> D10
 *   Both servo V+ -> external 5-7.4V supply (2-3A+ per servo), NOT the
 *   board's 5V pin. Servo GND, supply GND, and UNO Q GND must all be tied
 *   together (common ground).
 *
 * Requires the "Arduino_RouterBridge" sketch library (Add sketch library
 * panel in App Lab, or Arduino Library Manager). Servo.h ships built in
 * with the Arduino IDE.
 */

#include <Servo.h>
#include "Arduino_RouterBridge.h"

#define SERVO_PAN_PIN  9
#define SERVO_TILT_PIN 10

Servo servoPan;
Servo servoTilt;

int panAngle  = 90;   // start centered
int tiltAngle = 90;

const int STEP       = 5;    // degrees moved per keypress
const int MIN_ANGLE  = 0;
const int MAX_ANGLE  = 180;

// Called from Python via: Bridge.call("move_servo", "up" / "down" / "left" / "right" / "center")
const char* move_servo(const char* direction) {
  if (strcmp(direction, "left") == 0) {
    panAngle = max(MIN_ANGLE, panAngle - STEP);
  } else if (strcmp(direction, "right") == 0) {
    panAngle = min(MAX_ANGLE, panAngle + STEP);
  } else if (strcmp(direction, "up") == 0) {
    tiltAngle = min(MAX_ANGLE, tiltAngle + STEP);
  } else if (strcmp(direction, "down") == 0) {
    tiltAngle = max(MIN_ANGLE, tiltAngle - STEP);
  } else if (strcmp(direction, "center") == 0) {
    panAngle = 90;
    tiltAngle = 90;
  } else {
    return "UNKNOWN_DIRECTION";
  }

  servoPan.write(panAngle);
  servoTilt.write(tiltAngle);

  Monitor.print("pan=");
  Monitor.print(panAngle);
  Monitor.print(" tilt=");
  Monitor.println(tiltAngle);

  return "OK";
}

void setup() {
  Bridge.begin();
  Monitor.begin();

  servoPan.attach(SERVO_PAN_PIN);
  servoTilt.attach(SERVO_TILT_PIN);
  servoPan.write(panAngle);
  servoTilt.write(tiltAngle);

  Bridge.provide_safe("move_servo", move_servo);
  Monitor.println("Bridge ready - waiting for arrow-key commands");
}

void loop() {
  // Keep empty/non-blocking: all work happens in the Bridge callback above.
}
